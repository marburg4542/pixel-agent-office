# ===== ตั้งค่าเซิร์ฟเวอร์ Pixel Agent Office =====
# รัน `npm run setup` เพื่อสร้าง server/.env ให้อัตโนมัติ (สุ่มรหัสลับให้เลย) แล้วค่อยแก้ค่าที่เหลือ
# ห้าม commit ไฟล์ server/.env (อยู่ใน .gitignore แล้ว)

PORT=5200

# ความลับสำหรับเซ็น JWT — ยาวอย่างน้อย 32 ตัวอักษร (เปลี่ยนแล้วทุกคนต้องล็อกอินใหม่)
JWT_SECRET=

# กุญแจเข้ารหัส API key ของผู้ใช้ — 32 ไบต์แบบ base64
# ⚠️ ห้ามเปลี่ยนหรือทำหาย: ถ้าเปลี่ยน API key ที่ผู้ใช้บันทึกไว้ทั้งหมดจะถอดรหัสไม่ได้
ENCRYPTION_KEY=

# ไฟล์ฐานข้อมูล SQLite (อยู่ในโฟลเดอร์ server/ หรือใส่ path เต็ม)
DB_FILE=pixel-office.sqlite

# URL หน้าเว็บที่อนุญาต (CORS) + ฐานของลิงก์ในอีเมล — ใส่ได้หลายค่าคั่นด้วยจุลภาค
# ใส่โดเมนที่ใช้งานจริงไว้ "ตัวแรก" เช่น
# FRONTEND_URL=https://office.example.com,https://marburg4542.github.io,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# แอดมินคนแรก — สร้างอัตโนมัติตอนเปิดเซิร์ฟเวอร์ครั้งแรก (ใช้อนุมัติคนที่สมัครเข้ามา)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# อีเมล — ใช้ส่งลิงก์รีเซ็ตรหัสผ่านและแจ้งผลอนุมัติบัญชี (เหมือน WMS)
#   แบบ ก) SMTP : ตั้ง EMAIL_HOST (+ EMAIL_PORT / EMAIL_SECURE)
#   แบบ ข) Gmail: เว้น EMAIL_HOST ไว้ ใส่ EMAIL_USER + App Password (myaccount.google.com/apppasswords)
# เว้นว่างทั้งหมดได้ ระบบยังใช้งานได้ แต่จะส่งอีเมลไม่ได้
# ---------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
